{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineticdiskcover.dev/schemas/run_record.schema.json",
  "title": "Immutable KineticDiskCover run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_key",
    "experiment_id",
    "instance_id",
    "algorithm",
    "objective",
    "repeat",
    "seed",
    "status",
    "requested_backend",
    "selected_backend",
    "actual_backend",
    "backend_details",
    "started_at",
    "finished_at",
    "configuration_sha256",
    "input_sha256",
    "result",
    "verification",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_key": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "instance_id": { "type": "string", "minLength": 1 },
    "algorithm": { "type": "string", "minLength": 1 },
    "objective": { "enum": ["minmax", "minsum"] },
    "family": { "type": "string", "minLength": 1 },
    "n": { "type": "integer", "minimum": 0 },
    "m": { "type": "integer", "minimum": 0 },
    "repeat": { "type": "integer", "minimum": 0 },
    "seed": { "type": "integer", "minimum": 0 },
    "rerun_of": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "TIME_LIMIT",
        "CANCELLED",
        "INVALID",
        "SKIPPED",
        "ABANDONED",
        "TIMED_OUT"
      ]
    },
    "requested_backend": { "type": "string", "minLength": 1 },
    "selected_backend": { "type": ["string", "null"] },
    "actual_backend": { "type": ["string", "null"] },
    "backend_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "backend_version",
        "backend_detection",
        "capabilities"
      ],
      "properties": {
        "native": { "type": "boolean" },
        "backend_version": { "type": "string" },
        "backend_detection": { "type": "object" },
        "capabilities": { "type": "object" }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "input_sha256": { "$ref": "#/$defs/sha256" },
    "resolved_configuration": { "type": "object" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "solver_version", "platform"],
      "properties": {
        "source_commit": { "type": ["string", "null"] },
        "solver_version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "anyOf": [
        { "$ref": "#/$defs/result" },
        { "type": "null" }
      ]
    },
    "verification": {
      "anyOf": [
        { "$ref": "#/$defs/verification" },
        { "type": "null" }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finiteNumber": { "type": ["number", "null"] },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "experiment_id",
        "result_sha256",
        "verification_mode",
        "status",
        "kind",
        "passed",
        "continuous",
        "checked_at",
        "message"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "experiment_id": { "type": "string", "minLength": 1 },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "verification_mode": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
        "kind": {
          "enum": [
            "NONE",
            "EMPIRICAL",
            "CERTIFIED_CONTINUOUS",
            "CONTINUOUS_UNCERTIFIED"
          ]
        },
        "passed": { "type": "boolean" },
        "continuous": { "type": "boolean" },
        "checked_at": { "type": "string", "format": "date-time" },
        "message": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "CERTIFIED_CONTINUOUS" } },
            "required": ["kind"]
          },
          "then": { "properties": { "continuous": { "const": true } } }
        },
        {
          "if": {
            "properties": { "kind": { "const": "EMPIRICAL" } },
            "required": ["kind"]
          },
          "then": { "properties": { "continuous": { "const": false } } }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feasible",
        "objective_value",
        "lower_bound",
        "upper_bound",
        "optimality_status",
        "error_message",
        "solver_result"
      ],
      "properties": {
        "feasible": { "type": "boolean" },
        "objective_value": { "$ref": "#/$defs/finiteNumber" },
        "lower_bound": { "$ref": "#/$defs/finiteNumber" },
        "upper_bound": { "$ref": "#/$defs/finiteNumber" },
        "optimality_status": {
          "enum": ["OPTIMAL", "FEASIBLE", "TIME_LIMIT", "FAILED"]
        },
        "error_message": { "type": ["string", "null"] },
        "solver_result": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
