{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineticdiskcover.dev/schemas/run_plan_entry.schema.json",
  "title": "Expected KineticDiskCover run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_key",
    "instance_id",
    "algorithm",
    "objective",
    "repeat",
    "seed",
    "configuration_sha256",
    "requested_backend",
    "resolved_configuration"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_key": { "type": "string", "minLength": 1 },
    "instance_id": { "type": "string", "minLength": 1 },
    "algorithm": { "type": "string", "minLength": 1 },
    "objective": { "enum": ["minmax", "minsum", "minmaxsum"] },
    "repeat": { "type": "integer", "minimum": 0 },
    "seed": { "type": "integer", "minimum": 0 },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "requested_backend": { "type": "string", "minLength": 1 },
    "resolved_configuration": { "type": "object" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
