{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineticdiskcover.dev/schemas/input_ref.schema.json",
  "title": "Immutable KineticDiskCover input reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "canonical_path",
    "canonical_sha256",
    "source_path",
    "source_sha256",
    "family",
    "n",
    "m"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "instance_id": { "type": "string", "minLength": 1 },
    "canonical_path": { "type": "string", "minLength": 1 },
    "canonical_sha256": { "$ref": "#/$defs/sha256" },
    "source_path": { "type": ["string", "null"] },
    "source_sha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "family": { "type": "string", "minLength": 1 },
    "n": { "type": "integer", "minimum": 0 },
    "m": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
