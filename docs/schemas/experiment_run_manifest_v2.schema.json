{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineticdiskcover.dev/schemas/experiment_run_manifest_v2.schema.json",
  "title": "Version 2 immutable experiment run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_sha256",
    "created_at",
    "experiment_id",
    "run_id",
    "run_status",
    "input",
    "algorithm",
    "backends",
    "numeric_mode",
    "budgets",
    "tolerances",
    "build",
    "git",
    "resolved_configuration",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "manifest_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_status": {
      "enum": [
        "COMPLETED", "FAILED", "TIME_LIMIT", "CANCELLED", "INVALID",
        "SKIPPED", "ABANDONED", "TIMED_OUT"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "canonical_sha256",
        "generator_version",
        "registry_version",
        "numeric_mode",
        "seed",
        "prng",
        "replicate",
        "lifecycle"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "generator_version": { "type": "string", "minLength": 1 },
        "registry_version": { "type": "string", "minLength": 1 },
        "numeric_mode": { "type": "string", "minLength": 1 },
        "seed": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "prng": { "type": "string", "minLength": 1 },
        "replicate": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["designed", "generated", "validated", "used_in_run"],
          "properties": {
            "designed": { "type": ["boolean", "null"] },
            "generated": { "type": ["boolean", "null"] },
            "validated": { "type": ["boolean", "null"] },
            "used_in_run": { "type": ["boolean", "null"] }
          }
        }
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "objective", "model_regime"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "objective": { "enum": ["minmax", "minsum", "minmaxsum"] },
        "model_regime": { "type": "string", "minLength": 1 }
      }
    },
    "backends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "heuristic", "relaxation", "reported"],
      "properties": {
        "exact": { "$ref": "#/$defs/backend" },
        "heuristic": { "$ref": "#/$defs/backend" },
        "relaxation": { "$ref": "#/$defs/backend" },
        "reported": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "selected", "actual", "version"],
          "properties": {
            "requested": { "type": "string", "minLength": 1 },
            "selected": { "type": ["string", "null"] },
            "actual": { "type": ["string", "null"] },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "numeric_mode": { "type": "string", "minLength": 1 },
    "budgets": { "type": "object" },
    "tolerances": { "type": "object" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "compiler_version", "build_type", "libraries"],
      "properties": {
        "compiler": { "type": "string", "minLength": 1 },
        "compiler_version": { "type": "string", "minLength": 1 },
        "build_type": { "type": "string", "minLength": 1 },
        "libraries": { "type": "object" }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "status_sha256", "captured_at"],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] },
        "status_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "resolved_configuration": { "type": "object" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "solution", "trace", "verifier"],
      "properties": {
        "result": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "solution": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "verifier": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "name", "version"],
      "properties": {
        "status": { "enum": ["USED", "NOT_USED", "UNRESOLVED"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
