{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineticdiskcover.dev/schemas/verification.schema.json",
  "title": "KineticDiskCover verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "result_sha256",
    "verification_mode",
    "status",
    "kind",
    "passed",
    "continuous",
    "checked_at",
    "message"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verification_mode": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
    "kind": {
      "enum": [
        "NONE",
        "EMPIRICAL",
        "CERTIFIED_CONTINUOUS",
        "CONTINUOUS_UNCERTIFIED"
      ]
    },
    "passed": { "type": "boolean" },
    "continuous": { "type": "boolean" },
    "checked_at": { "type": "string", "format": "date-time" },
    "message": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "CERTIFIED_CONTINUOUS" } },
        "required": ["kind"]
      },
      "then": { "properties": { "continuous": { "const": true } } }
    },
    {
      "if": {
        "properties": { "kind": { "const": "EMPIRICAL" } },
        "required": ["kind"]
      },
      "then": { "properties": { "continuous": { "const": false } } }
    }
  ]
}
