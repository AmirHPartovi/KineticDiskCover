{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineticdiskcover.dev/schemas/result.schema.json",
  "title": "Canonical KineticDiskCover run result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "run_key",
    "execution_status",
    "solver_result",
    "error_message"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "run_key": { "type": "string", "minLength": 1 },
    "execution_status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "TIME_LIMIT",
        "INVALID",
        "TIMED_OUT",
        "CANCELLED",
        "SKIPPED",
        "ABANDONED"
      ]
    },
    "solver_result": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "objective": { "enum": ["minmax", "minsum", "minmaxsum"] },
        "objective_value": { "type": ["number", "null"] },
        "objective_vector": {
          "anyOf": [
            { "$ref": "#/$defs/objectiveVector" },
            { "type": "null" }
          ]
        },
        "joint": {
          "anyOf": [
            { "$ref": "#/$defs/jointResult" },
            { "type": "null" }
          ]
        }
      }
    },
    "error_message": { "type": ["string", "null"] }
  },
  "$defs": {
    "finiteNumber": { "type": ["number", "null"] },
    "objectiveVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peak_cost", "integral_cost"],
      "properties": {
        "peak_cost": { "$ref": "#/$defs/finiteNumber" },
        "integral_cost": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "jointResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minmax_component_status",
        "minsum_component_status",
        "minmax_component_optimality",
        "minsum_component_optimality",
        "joint_optimality_status",
        "dominates_minmax",
        "dominates_minsum",
        "dominance_invariants_ok",
        "minmax_component_peak",
        "minmax_component_integral",
        "minsum_component_peak",
        "minsum_component_integral",
        "minmax_source_run",
        "minsum_source_run"
      ],
      "properties": {
        "minmax_component_status": {
          "enum": ["NOT_RUN", "COMPLETED", "TIME_LIMIT", "FAILED"]
        },
        "minsum_component_status": {
          "enum": ["NOT_RUN", "COMPLETED", "TIME_LIMIT", "FAILED"]
        },
        "minmax_component_optimality": {
          "enum": ["OPTIMAL", "FEASIBLE", "TIME_LIMIT", "FAILED"]
        },
        "minsum_component_optimality": {
          "enum": ["OPTIMAL", "FEASIBLE", "TIME_LIMIT", "FAILED"]
        },
        "joint_optimality_status": {
          "enum": ["OPTIMAL", "FEASIBLE", "TIME_LIMIT", "FAILED"]
        },
        "dominates_minmax": { "type": "boolean" },
        "dominates_minsum": { "type": "boolean" },
        "dominance_invariants_ok": { "type": "boolean" },
        "minmax_component_peak": { "$ref": "#/$defs/finiteNumber" },
        "minmax_component_integral": { "$ref": "#/$defs/finiteNumber" },
        "minsum_component_peak": { "$ref": "#/$defs/finiteNumber" },
        "minsum_component_integral": { "$ref": "#/$defs/finiteNumber" },
        "minmax_source_run": { "type": "string" },
        "minsum_source_run": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "solver_result": {
            "type": "object",
            "properties": { "objective": { "const": "minmaxsum" } },
            "required": ["objective"]
          }
        },
        "required": ["solver_result"]
      },
      "then": {
        "properties": {
          "solver_result": {
            "required": ["objective_vector", "joint"],
            "properties": {
              "objective_value": { "type": "null" }
            }
          }
        }
      }
    }
  ]
}
